# ===== LLM 供应商配置 =====
# 当前默认供应商与模型(程序缺省用这两个)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# DeepSeek(OpenAI 兼容 API,经 langchain-openai 的 ChatOpenAI 接入)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-5

# ===== RAG 嵌入模型 =====
# EMBEDDING_PROVIDER: huggingface(默认,本地 sentence-transformers,离线可用)
#   | openai-compatible(远程 OpenAI 兼容 embedding 服务,经 langchain-openai 接入);
#   其他值(拼写错误)运行时抛 RagError,不静默回退
# EMBEDDING_MODEL: huggingface 默认 BAAI/bge-small-zh-v1.5;
#   openai-compatible 默认 Qwen/Qwen3-Embedding-8B
# EMBEDDING_BASE_URL: openai-compatible 必填(缺失运行时抛清晰错误)
# EMBEDDING_API_KEY: 可选,默认空(免鉴权服务可不配;配了会作为 Bearer 发送)
#
# ⚠️ 换嵌入模型 = 向量空间变更:已有向量全部失效,必须 drop data/kingdee-rag
# 后全量重灌(流程见 knowledge-steward 维护手册 §5)
EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
#
# 远程示例(openclaw memorySearch 团队嵌入服务):
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=http://10.33.17.234:32320
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# EMBEDDING_API_KEY=

# ===== agent1 舆情方案生成 Agent =====
# gateway MCP(websearch 池:brave/tavily/serpapi)
MCP_GATEWAY_URL=http://10.33.17.72:8082/mcp
MCP_GATEWAY_TOKEN=tok_o-KDYH64LdMNmDPRIZqB1-4CpnRXSLiu

# 本服务 API 的 apikey → 用户标识 映射(JSON 格式)
API_KEYS_JSON={"sk-demo-key": "demo-user"}

# ===== kingdee-plugin-agent:金蝶云星空环境 =====
# KD_* 4 项硬门槛:Web API 缺任一拒绝建任务(503 并点明缺项);CLI 至少需 KD_BASE_URL
KD_BASE_URL=https://your-kingdee-host
KD_USERNAME=your-account
KD_PASSWORD=your-password
KD_DATA_CENTER=your-data-center

# 编译服务地址(编译容器 HTTP 服务,缺省 http://localhost:8000;docker-compose up 起)
COMPILE_SERVICE_URL=http://localhost:8000
# 编译服务环境变量(Windows 原生部署为主,见 docs/kingdee-plugin-agent/windows-deployment.md;
# 全部可选,缺省代码相对,零硬编码部署路径;端口/监听地址由 uvicorn 启动参数控制,不读 PORT/HOST env):
#   COMPILE_SERVICE_REQUIRES_DLLS=1  走真实 msbuild 后端(mock 不当质量门;容器镜像 Dockerfile 无条件设 1,
#                                     references 目录为空时容器启动即失败 —— 未提供金蝶 BOS DLL 前不要起容器)
#   REFS_DIR                         金蝶 BOS DLL 目录(缺省:代码相对 compile_service/build/references)
#   TARGET_FRAMEWORK=v4.8            编译目标(.NET 4.8 Developer Pack)
#   MSBUILD_PATH                     显式 msbuild 路径(缺省自动探测:PATH → Framework 兜底)
#   FRAMEWORK_MSBUILD_PATH           覆盖 Framework 兜底路径(系统盘非 C: 时)
#   COMPILE_ARTIFACT_DIR             编译产物 DLL 留存目录(缺省:代码相对 仓库根/data/kingdee-compiled)
#   KINGDEE_BIN_DIR                  金蝶 WebSite\bin 源目录(fetch_kingdee_dlls.ps1 拷贝用,-SourceDir 优先)
# COMPILE_SERVICE_REQUIRES_DLLS=1
# REFS_DIR=/app/refs

# 本服务 API 的 apikey(建任务/查状态/回答/验收都要带 X-API-Key 头;未配置默认拒绝 401)
KINGDEE_API_KEY=sk-demo-key

# ===== OpenTelemetry =====
# collector 地址(OTel 全链路,配了才上报;留空本地不阻塞,span 走 no-op tracer)
# OTEL_ENDPOINT=http://localhost:4318/v1/traces
