# ===== LLM 供应商配置 =====
# 当前默认供应商与模型(程序缺省用这两个)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# DeepSeek(OpenAI 兼容 API,经 langchain-openai 的 ChatOpenAI 接入)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-5

# ===== agent1 舆情方案生成 Agent =====
# gateway MCP(websearch 池:brave/tavily/serpapi)
MCP_GATEWAY_URL=http://10.33.17.72:8082/mcp
MCP_GATEWAY_TOKEN=tok_o-KDYH64LdMNmDPRIZqB1-4CpnRXSLiu

# 本服务 API 的 apikey → 用户标识 映射(JSON 格式)
API_KEYS_JSON={"sk-demo-key": "demo-user"}

# ===== kingdee-plugin-agent:金蝶云星空环境 =====
# KD_* 4 项硬门槛:Web API 缺任一拒绝建任务(503 并点明缺项);CLI 至少需 KD_BASE_URL
KD_BASE_URL=https://your-kingdee-host
KD_USERNAME=your-account
KD_PASSWORD=your-password
KD_DATA_CENTER=your-data-center

# 编译服务地址(编译容器 HTTP 服务,缺省 http://localhost:8000;docker-compose up 起)
COMPILE_SERVICE_URL=http://localhost:8000
# 编译容器内真实 msbuild 后端:镜像 Dockerfile 无条件设 COMPILE_SERVICE_REQUIRES_DLLS=1,
# references 目录为空时容器启动即失败 —— 未提供金蝶 BOS DLL 前不要起容器
# COMPILE_SERVICE_REQUIRES_DLLS=1
# REFS_DIR=/app/refs

# 本服务 API 的 apikey(建任务/查状态/回答/验收都要带 X-API-Key 头;未配置默认拒绝 401)
KINGDEE_API_KEY=sk-demo-key

# ===== OpenTelemetry =====
# collector 地址(OTel 全链路,配了才上报;留空本地不阻塞,span 走 no-op tracer)
# OTEL_ENDPOINT=http://localhost:4318/v1/traces
